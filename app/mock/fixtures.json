{
  "models": [
    {
      "id": "demo_faraday",
      "title": "Demo: Faraday current distribution",
      "description": "Synthetic demo model producing every plot kind so the UI can be developed without Python.",
      "package": "platesim.demo",
      "params": [
        {
          "name": "I_total_mA",
          "type": "float",
          "default": 48.0,
          "min": 0.1,
          "max": 500,
          "unit": "mA",
          "help": "Total cell current. [J]"
        },
        {
          "name": "n_points",
          "type": "int",
          "default": 64,
          "min": 8,
          "max": 512,
          "unit": "",
          "help": "Number of mesh points along the coupon. [J]"
        },
        {
          "name": "stir_rpm",
          "type": "float",
          "default": 120.0,
          "min": 0,
          "max": 1000,
          "unit": "rpm",
          "help": "Rotating disk electrode stir rate. [J]"
        },
        {
          "name": "recipe",
          "type": "enum",
          "choices": ["dc", "plan_ramp", "pulses"],
          "default": "dc",
          "help": "Waveform recipe. [J]"
        },
        {
          "name": "taped",
          "type": "bool",
          "default": true,
          "help": "Whether the back side is taped (insulated). [J]"
        }
      ]
    },
    {
      "id": "demo_feature_fill",
      "title": "Demo: Via bottom-up fill",
      "description": "Synthetic feature-fill demo producing contour frames of a via cross-section (r >= 0; the app mirrors to -r).",
      "package": "platesim.demo",
      "params": [
        {
          "name": "via_diam_um",
          "type": "float",
          "default": 50.0,
          "min": 5,
          "max": 300,
          "unit": "um",
          "help": "Via diameter. [J]"
        },
        {
          "name": "aspect_ratio",
          "type": "float",
          "default": 4.0,
          "min": 0.5,
          "max": 12,
          "unit": "",
          "help": "Depth / diameter. [J]"
        },
        {
          "name": "suppressors_ppm",
          "type": "float",
          "default": 10.0,
          "min": 0,
          "max": 200,
          "unit": "ppm",
          "help": "Suppressor concentration. [J]"
        }
      ]
    }
  ],
